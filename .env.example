# Database per instansi 
POSTGRES_AGGREGATOR_USER=admin
POSTGRES_AGGREGATOR_PASSWORD=changeme
POSTGRES_AGGREGATOR_DB=changeme
POSTGRES_PVMBG_USER=admin
POSTGRES_PVMBG_PASSWORD=changeme
POSTGRES_PVMBG_DB=changeme
POSTGRES_BMKG_USER=admin
POSTGRES_BMKG_PASSWORD=changeme
POSTGRES_BMKG_DB=changeme
POSTGRES_INGEST_USER=admin
POSTGRES_INGEST_PASSWORD=changeme
POSTGRES_INGEST_DB=changeme
BMKG_BASE_URL=changeme
PVMBG_BASE_URL=changeme

# Credentials
PVMBG_SECRET_KEY=changeme
BMKG_API_KEY=changeme
PVMBG_TOKEN=changeme


# Configuration
SOURCE_TIMEOUT_MS=changeme
POLL_INTERVAL_MS=changeme
PVMBG_MIN_DELAY=changeme
PVMBG_MAX_DELAY=changeme
DLQ_MAX_ATTEMPTS=5
DLQ_RETRY_DELAY_MS=30000


# Satellite credentials
SATELLITE_PROCESSOR_API_KEY=changeme 
SATELLITE_FEED_TOKEN=changeme            
SATELLITE_FEED_URL=https://satellite.naufarrel.dev
LATENESS_LIMIT_MIN=300
POSTGRES_SATELLITE_USER=admin
POSTGRES_SATELLITE_PASSWORD=changeme
POSTGRES_SATELLITE_DB=changeme

#Token service
TOKEN_DB_PASSWORD=changeme
JWT_ISSUER=bnpb-token
JWT_AUDIENCE=bnpb-client-api
ACCESS_TOKEN_TTL_SECONDS=60
REFRESH_TOKEN_TTL_SECONDS=600
INTROSPECT_SERVICE_KEY=changeme

# Client
MEDIA_CLIENT_ID=media-client
MEDIA_CLIENT_SECRET=changeme
LAPANGAN_CLIENT_ID=lapangan-client
LAPANGAN_CLIENT_SECRET=changeme
INTERNAL_CLIENT_ID=internal-client
INTERNAL_CLIENT_SECRET=changeme

#RabbitMW
RABBITMQ_USER=changeme
RABBITMQ_PASSWORD=changeme
# Aggregator - penyimpanan HazardEvent terdistribusi (P1)
# Di Kubernetes, SHARD_N_URI diambil dari Secret shard-N-app (key "uri") yang dibuat CNPG.
SHARD_COUNT=3
SHARD_1_URI=changeme
SHARD_2_URI=changeme
SHARD_3_URI=changeme

# SHARD_1_READ_URI=
META_SHARD=shard-1
SHARD_READ_TIMEOUT_MS=3000
SHARD_WRITE_TIMEOUT_MS=3000
SHARD_AUDIT_TIMEOUT_MS=20000

AUDIT_TOKEN=changeme
AUDIT_RATE_LIMIT_PER_SEC=50

# Aggregator - koordinasi multi-instance (P2)
# Lease diperbarui tiap siklus polling; TTL dihitung dengan jam database, bukan jam node.
LEASE_TTL_SECONDS=15
RATE_LIMIT_PER_SEC=100
SHUTDOWN_DRAIN_MS=3000
SHUTDOWN_FORCE_MS=25000
MAX_BODY_BYTES=1048576
MAX_JSON_DEPTH=64

# Sensor Pantai (P5)
# Token dipakai bersama oleh Sensor Pantai (token yang diharapkan) dan Aggregator.
# Di Kubernetes diambil dari Secret pantai-token (key "token"). Tanpa token, Aggregator tidak mem-polling sensor.
PANTAI_BASE_URL=http://sensor-pantai:8080
PANTAI_AUTH_TOKEN=changeme
PANTAI_POLL_MS=1000
PANTAI_TIMEOUT_MS=1500
PANTAI_PAGE_LIMIT=200
PANTAI_MAX_PAGES=5
PANTAI_STATIONS_TTL_MS=300000
# Validasi kontrak: nilai di luar batas ini disisihkan ke rejected_messages
PANTAI_MAX_SEA_LEVEL_M=30
PANTAI_MAX_WAVE_M=60
PANTAI_QUALITY_OK=ok
# Sensor dianggap basi bila generated_at tertinggal dari pengamatan terbaru lebih dari batas ini (detik)
PANTAI_MAX_LAG_S=900
# Status sumber di respons /hazard-events menjadi "stale" bila tidak ada polling sukses selama ini (ms)
PANTAI_STALE_AFTER_MS=15000

# Circuit breaker ke Sensor Pantai (P5)
BREAKER_FAILURES=3
BREAKER_OPEN_MS=5000
BREAKER_MAX_OPEN_MS=60000

# Jalur alert kritis: relay outbox ke RabbitMQ (P5)
OUTBOX_POLL_MS=500
OUTBOX_BATCH=50

# Client service - load shedding berprioritas (P5)
# Media dibatasi pada CLIENT_MAX_INFLIGHT * CLIENT_MEDIA_SHARE; sisanya dicadangkan untuk Tim Lapangan.
CLIENT_MAX_INFLIGHT=200
CLIENT_MEDIA_SHARE=0.6

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme


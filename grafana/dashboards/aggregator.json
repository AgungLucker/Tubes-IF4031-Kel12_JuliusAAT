    {
      "id": 14,
      "type": "table",
      "title": "Pemegang lease saat ini",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aggregator_is_leader{service=\"aggregator\",pod=~\"$pod\"} == 1",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "service": true
            },
            "renameByName": {
              "source": "Sumber",
              "pod": "Pod (leader)",
              "Value": "is_leader"
            }
          }
        }
      ]
    },

      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(http_request_duration_seconds_bucket{service=\"aggregator\",pod=~\"$pod\",route!~\"/metrics|/health.*\"}[5m])))",
          "legendFormat": "{{route}}"
        }
      ]

{
    "uid": "satellite-processor-metrics",
    "title": "Satellite Processor Service Metrics",
    "schemaVersion": 39,
    "time": {
        "from": "now-1h",
        "to": "now"
    },
    "refresh": "15s",
    "panels": [
        {
            "id": 1,
            "type": "timeseries",
            "title": "Feed lag (satellite-processor)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 0,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "satellite_feed_lag",
                    "legendFormat": "lag"
                }
            ]
        },
        {
            "id": 2,
            "type": "timeseries",
            "title": "Throughput event (satellite-processor)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 12,
                "y": 0,
                "w": 12,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "ops"
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "deriv(satellite_committed_offset[1m])",
                    "legendFormat": "event/detik"
                }
            ]
        },
        {
            "id": 3,
            "type": "timeseries",
            "title": "p95 latensi commit (satellite-processor)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 0,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(satellite_commit_latency_seconds_bucket[5m])))",
                    "legendFormat": "p95"
                }
            ]
        },
        {
            "id": 4,
            "type": "stat",
            "title": "Deteksi ditolak karena terlambat",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 12,
                "y": 8,
                "w": 12,
                "h": 8
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "satellite_late_rejected_total",
                    "legendFormat": "ditolak"
                }
            ]
        },
        {
            "id": 5,
            "type": "timeseries",
            "title": "Request rate",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 0,
                "y": 16,
                "w": 8,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(http_requests_total{job=\"satellite-processor\"}[1m]))",
                    "legendFormat": "request/detik"
                }
            ]
        },
        {
            "id": 6,
            "type": "timeseries",
            "title": "Error rate 5xx",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 8,
                "y": 16,
                "w": 8,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps"
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "sum(rate(http_requests_total{job=\"satellite-processor\",status=~\"5..\"}[1m]))",
                    "legendFormat": "5xx/detik"
                }
            ]
        },
        {
            "id": 7,
            "type": "timeseries",
            "title": "p95 latensi HTTP",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 16,
                "y": 16,
                "w": 8,
                "h": 8
            },
            "fieldConfig": {
                "defaults": {
                    "unit": "s"
                },
                "overrides": []
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"satellite-processor\"}[5m])))",
                    "legendFormat": "p95"
                }
            ]
        },
        {
            "id": 8,
            "type": "stat",
            "title": "Event feed rusak (dilewati)",
            "datasource": {
                "type": "prometheus",
                "uid": "prometheus"
            },
            "gridPos": {
                "x": 0,
                "y": 24,
                "w": 8,
                "h": 8
            },
            "targets": [
                {
                    "refId": "A",
                    "expr": "satellite_malformed_events_total",
                    "legendFormat": "dilewati"
                }
            ]
        }
    ]
}